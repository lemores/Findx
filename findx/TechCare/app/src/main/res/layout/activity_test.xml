<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
    android:id="@+id/tela"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="start|end"
    tools:context=".MapsActivity">


    <include xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:map="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/include"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        layout="@layout/activity_maps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MapsActivity" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="150dp"
        android:indeterminateTint="@android:color/white"
        android:progressDrawable="@drawable/circular_progress_bar"
        android:visibility="visible"
        app:layout_anchor="@+id/include"
        app:layout_anchorGravity="end|center" />

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/openMenu"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_map"
        android:layout_marginTop="30dp"
        android:layout_marginStart="4dp"
        android:elevation="10.0001dp"
        android:fadingEdgeLength="0dp"/>

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/clear"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="60dp"
        android:elevation="10.0001dp"
        android:fadingEdgeLength="0dp"
        android:src="@drawable/ic_close_black_8dp"
        android:visibility="gone"
        app:layout_anchor="@+id/searchbar"
        app:layout_anchorGravity="end|center" />

    <AutoCompleteTextView
        android:id="@+id/searchbar"
        android:completionThreshold="1"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:paddingEnd="5dp"
        android:paddingStart="40dp"
        android:elevation="3dp"
        android:fadingEdgeLength="-10dp"
        android:shadowColor="#0000"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="55dp"
        android:layout_marginTop="30dp"
        android:layout_weight="4"
        android:background="@drawable/costume_edit_text_bg"
        android:hint="@string/text_searchbar"
        android:singleLine="true"
        android:textAllCaps="false"
        android:textColor="#333"
        android:textColorHint="#5e5e5e"
        android:visibility="visible"
        app:layout_anchor="@+id/include"
        app:layout_anchorGravity="left|top" />


    <android.support.design.widget.FloatingActionButton
        android:id="@+id/search_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:fabSize="mini"
        android:backgroundTint="#0088ff"
        android:elevation="10dp"
        android:fadingEdgeLength="9dp"
        app:fab_elevationCompat="10dp"
        app:rippleColor="#7be"
        app:fab_colorRipple="#ccc"
        app:borderWidth="0dp"
        android:onClick="onMapSearch"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="0.5"
        android:src="@drawable/ic_search_black_24dp"
        app:layout_anchor="@+id/include"
        app:layout_anchorGravity="right|top"/>

    <android.support.design.widget.FloatingActionButton
        android:id="@+id/center_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="79dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="0.5"
        android:backgroundTint="#fff"
        android:src="@drawable/ic_my_location_black_8dp"
        app:borderWidth="0dp"
        app:fabSize="mini"
        app:fab_colorRipple="#ccc"
        app:layout_anchor="@+id/include"
        app:layout_anchorGravity="right|top"
        app:rippleColor="#ccc" />


    <android.support.design.widget.BottomNavigationView
        android:id="@+id/Navbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/costume_act_bg2"
        android:paddingStart="-30dp"
        android:paddingEnd="25dp"
        android:visibility="gone"
        app:elevation="5dp"
        app:layout_anchor="@+id/include"
        app:layout_anchorGravity="right|bottom"
        app:menu="@menu/navigation"
        tools:context=".MapsActivity" />

    <android.support.design.widget.FloatingActionButton
        android:id="@+id/navfab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:backgroundTint="#fff"
        android:elevation="5dp"
        android:fadingEdgeLength="0dp"
        android:src="@drawable/ic_add_24dp"
        app:backgroundTint="#00000000"
        app:borderWidth="0dp"
        app:elevation="0dp"
        app:fab_colorRipple="#ccc"
        app:fab_elevationCompat="0dp"
        app:fab_shadowColor="#00000000"
        app:fab_shadowRadius="0dp"
        app:fab_shadowXOffset="0dp"
        app:fab_shadowYOffset="0dp"
        app:layout_anchor="@+id/include"
        app:layout_anchorGravity="right|bottom"
        app:rippleColor="#ccc"
        tools:context=".MapsActivity" />
    <android.support.design.widget.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
