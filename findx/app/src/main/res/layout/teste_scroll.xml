<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    android:id="@+id/jose"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#232323"
    tools:context=".Suggestion">


    <ImageView
        android:id="@+id/assistImage"
        android:layout_width="410dp"
        android:layout_height="215dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="256dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.505"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/button2"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/voltar"
        android:onClick="voltar"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.049"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.059" />



    <!-- daqui pra cima esquece -->

    <ScrollView
        android:id="@+id/scrollviewbolado"
        android:layout_width="match_parent"
        android:layout_height="666dp"
        app:layout_constraintBottom_toBottomOf="@+id/jose"
        app:layout_constraintEnd_toEndOf="@id/jose"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/jose"
        app:layout_constraintTop_toBottomOf="@+id/assistImage"
        app:layout_constraintVertical_bias="0.0">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/scrollviewbolado">


            <TextView
                android:id="@+id/categoria_textview"
                android:layout_width="200dp"
                android:layout_height="51dp"
                android:fontFamily="@font/semiboldsegoeui"
                android:paddingLeft="10dp"
                android:textColor="#707070"
                android:textSize="17dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.144"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tipo_textview"
                tools:ignore="MissingConstraints,OnClick" />

            <View
                android:id="@+id/divider4"
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:background="?android:attr/listDivider"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <TextView
                android:id="@+id/avalTextview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/semiboldsegoeui"
                android:text="Sua avaliação"
                android:textColor="#ffff"
                android:visibility="gone"
                tools:layout_editor_absoluteX="311dp"
                tools:layout_editor_absoluteY="793dp"
                tools:ignore="MissingConstraints" />

            <View
                android:id="@+id/divider2"
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:background="?android:attr/listDivider"
                android:visibility="visible"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/telefone"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <TextView
                android:id="@+id/telefone_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:textColor="#ffff"
                android:textSize="17dp"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/localizacao"
                android:visibility="visible"
                app:layout_constraintEnd_toStartOf="@+id/localizacao_textview"
                app:layout_constraintHorizontal_bias="0.41"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/localizacao_textview"
                android:layout_width="287dp"
                android:layout_height="52dp"
                android:text="TextView"
                android:textColor="#ffff"
                android:textSize="17dp"
                android:visibility="visible"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="74dp"
                tools:layout_editor_absoluteY="288dp" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/horario"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <TextView
                android:id="@+id/horario_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:textColor="#ffff"
                android:textSize="17dp"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <View
                android:id="@+id/divider5"
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:background="?android:attr/listDivider"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <View
                android:id="@+id/divider6"
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:background="?android:attr/listDivider"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/site"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <TextView
                android:id="@+id/site_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:textColor="#ffff"
                android:textSize="17dp"
                android:visibility="gone"
                tools:layout_editor_absoluteX="-7dp"
                tools:layout_editor_absoluteY="305dp" />

            <Button
                android:id="@+id/favB"
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:layout_marginTop="24dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@android:color/transparent"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.87"
                app:layout_constraintStart_toEndOf="@+id/nome_textview"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />

            <ImageView
                android:id="@+id/favImage"
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:background="@drawable/salvar"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@+id/favB"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/favB"
                app:layout_constraintTop_toTopOf="@+id/favB"
                app:layout_constraintVertical_bias="0.0"
                tools:ignore="MissingConstraints" />

            <View
                android:id="@+id/divider"
                android:layout_width="wrap_content"
                android:layout_height="3dp"
                android:layout_marginTop="256dp"
                android:background="?android:attr/listDivider"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />

            <RatingBar
                android:id="@+id/ratedBar"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="88dp"
                android:layout_height="17dp"
                android:layout_marginTop="8dp"
                android:numStars="5"
                android:rating="4"
                android:stepSize="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.071"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nome_textview"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/tipo_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/semiboldsegoeui"
                android:text="Categoria"
                android:textColor="#14BFC5"
                android:textSize="17dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.067"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ratedBar"
                tools:ignore="MissingConstraints" />

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="235dp"
                android:layout_height="46dp"
                android:numStars="5"
                android:stepSize="1"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="74dp"
                tools:layout_editor_absoluteY="814dp" />

            <TextView
                android:id="@+id/nome_textview"
                android:layout_width="295dp"
                android:layout_height="31dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/segoeuibold"
                android:paddingLeft="5dp"
                android:textColor="#ffff"
                android:textSize="23dp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.033"
                tools:ignore="MissingConstraints" />

            <RelativeLayout
                android:id="@+id/relative"
                android:layout_width="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/comentarios_TextView"
                app:layout_constraintVertical_bias="0.0"
                android:background="#ffff"
                android:visibility="invisible"
                android:layout_height="wrap_content">

                <android.support.v7.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/comentar"
                    tools:ignore="MissingConstraints"
                    android:visibility="invisible" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:id="@+id/bottomRelative"
                    android:padding="4dp"
                    android:layout_alignParentBottom="true"
                    android:visibility="invisible">

                    <TextView
                        android:id="@+id/comentarios_TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comentários"
                        android:textSize="17dp"
                        android:textColor="#ffff"
                        app:layout_constraintBottom_toBottomOf="@+id/divider6"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.078"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/divider"
                        app:layout_constraintVertical_bias="0.056"
                        android:visibility="invisible"/>

                    <TextView
                        android:id="@+id/enviar_comentario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@+id/bottomRelative"
                        android:layout_marginTop="@+id/bottomRelative"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="@+id/bottomRelative"
                        android:layout_toStartOf="@id/comentarios_TextView"
                        android:layout_toEndOf="@id/comentar"
                        android:text="Enviar"
                        android:layout_alignParentEnd="true"
                        tools:ignore="NotSibling"
                        android:visibility="invisible"/>
                </RelativeLayout>

                <EditText
                    android:id="@+id/comentar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Deixe sua avaliação"
                    tools:ignore="MissingConstraints,NotSibling"
                    android:layout_marginBottom="15dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="70dp"
                    android:background="@drawable/background_transparent"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/enviar_comentario"
                    android:visibility="invisible"
                    />


            </RelativeLayout>

        </android.support.constraint.ConstraintLayout>
    </ScrollView>
</android.support.constraint.ConstraintLayout>