<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/relativeLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#232323"
    tools:context=".Suggestion_teste">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:id="@+id/assistImage"
        android:layout_centerHorizontal="true"
        android:foregroundGravity="center" />

    <TextView
        android:id="@+id/nome_textview"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/assistImage"
        android:layout_marginStart="15dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/segoeuibold"
        android:gravity="top"
        android:text="Nome_TextView"
        android:textColor="#ffff"
        android:textSize="23dp" />

    <android.support.constraint.ConstraintLayout
        android:id="@+id/constraint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="15dp"
        android:layout_toEndOf="@id/nome_textview"
        android:layout_below="@id/assistImage"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/favB"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="35dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="15dp"
            android:backgroundTint="@android:color/transparent"

            android:elevation="10dp"
            tools:ignore="MissingConstraints" />

        <ImageView
            android:id="@+id/favImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignBottom="@+id/favB"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="17dp"
            android:background="@drawable/salvar"
            android:elevation="0.001dp"
            tools:ignore="MissingConstraints" />

    </android.support.constraint.ConstraintLayout>

    <RatingBar
        android:id="@+id/ratedBar"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="82dp"
        android:layout_height="17dp"
        android:layout_marginStart="15dp"
        android:numStars="5"
        android:rating="4"
        android:stepSize="1"
        android:layout_below="@id/nome_textview"/>

    <!-- SCROLL VIEW ADIANTE APENAS-->

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ratedBar"
        android:layout_marginTop="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/linearMain">

            <ScrollView
                android:id="@+id/scrollView0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/ratedBar"
                android:layout_marginTop="3dp">


                <LinearLayout
                    android:id="@+id/linear0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tipo_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ratedBar"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/semiboldsegoeui"
                        android:text="Categoria"
                        android:textColor="#fff"
                        android:textSize="17dp" />

                    <TextView
                        android:id="@+id/categoria_textview"
                        android:layout_width="200dp"
                        android:layout_height="51dp"
                        android:layout_below="@+id/tipo_textview"
                        android:layout_marginStart="15dp"
                        android:fontFamily="@font/semiboldsegoeui"
                        android:paddingLeft="10dp"
                        android:text="TextView"
                        android:textColor="#707070"
                        android:textSize="17dp" />

                    <View
                        android:id="@+id/divider"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_below="@id/categoria_textview"
                        android:layout_marginTop="10dp"
                        android:background="?android:attr/listDivider" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/ratedBar"
                android:layout_marginTop="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/linear">


                    <ImageView
                        android:id="@+id/imageView4"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/localizacao"/>

                    <TextView
                        android:id="@+id/localizacao_textview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginEnd="17dp"
                        android:text="TextView"
                        android:textColor="#ffff"
                        android:textSize="17dp"/>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/scrollView2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/ratedBar"
                android:layout_marginTop="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/linear2">

                    <ImageView
                        android:id="@+id/imageView5"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/telefone"/>

                    <TextView
                        android:id="@+id/telefone_textview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginEnd="17dp"
                        android:text="TextView"
                        android:textColor="#ffff"
                        android:textSize="17dp"/>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/scrollView3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/ratedBar"
                android:layout_marginTop="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/linear3">

                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/horario"/>

                    <TextView
                        android:id="@+id/horario_textview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginEnd="17dp"
                        android:text="TextView"
                        android:textColor="#ffff"
                        android:textSize="17dp"/>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/scrollView4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/ratedBar"
                android:layout_marginTop="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/linear4">

                    <ImageView
                        android:id="@+id/imageView6"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/site"/>

                    <TextView
                        android:id="@+id/site_textview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginEnd="17dp"
                        android:text="TextView"
                        android:textColor="#ffff"
                        android:textSize="17dp"/>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/scrollView5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/ratedBar"
                android:layout_marginTop="3dp">

                <LinearLayout
                    android:id="@+id/linear5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/avaliaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/semiboldsegoeui"
                        android:foregroundGravity="center"
                        android:text="Sua avaliação"
                        android:textColor="#ffff" />

                    <RatingBar
                        android:id="@+id/ratingBar"
                        android:layout_width="235dp"
                        android:layout_height="46dp"
                        android:layout_gravity="center"
                        android:numStars="5"
                        android:stepSize="1" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>