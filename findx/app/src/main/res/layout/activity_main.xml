<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    android:id="@+id/tela"

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="start|end"
    tools:context=".MapsActivity">

    <android.support.design.widget.FloatingActionButton
        android:id="@+id/navfab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-40dp"
        android:backgroundTint="#fff"
        android:elevation="5dp"
        android:fadingEdgeLength="0dp"
        android:src="@drawable/ic_add_24dp"
        app:backgroundTint="#00000000"
        app:borderWidth="0dp"
        app:elevation="0dp"
        app:fab_colorRipple="#ccc"
        app:fab_elevationCompat="0dp"
        app:fab_shadowColor="#00000000"
        app:fab_shadowRadius="0dp"
        app:fab_shadowXOffset="0dp"
        app:fab_shadowYOffset="0dp"
        app:layout_anchorGravity="right|bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="#ccc"
        tools:context=".MapsActivity" />

    <android.support.design.widget.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-50dp"
        android:backgroundTint="#fff"
        android:fadingEdgeLength="0dp"
        android:visibility="gone"
        app:backgroundTint="#00000000"
        app:borderWidth="0dp"
        app:elevation="5.1dp"
        app:fab_colorRipple="#ccc"
        app:fab_elevationCompat="0dp"
        app:fab_shadowColor="#00000000"
        app:fab_shadowRadius="0dp"
        app:fab_shadowXOffset="0dp"
        app:fab_shadowYOffset="0dp"
        app:layout_anchorGravity="right|bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="#ccc"
        tools:context=".MapsActivity" />

    <android.support.design.widget.BottomNavigationView
        android:id="@+id/Navbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/costume_act_bg2"
        android:visibility="visible"
        app:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/navigation"
        tools:context=".MapsActivity" />

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/openMenu"
        android:layout_width="38dp"
        android:layout_height="38dp"
