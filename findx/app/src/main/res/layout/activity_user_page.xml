<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp"
    android:background="@color/colorPrimary"
    android:fitsSystemWindows="true"
    tools:context="com.ebanx.circularreveal.SecondActivity">

    <TextView
        android:id="@+id/perfilUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perfil do usuário"
        android:layout_centerHorizontal="true"
        android:textSize="25dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/segoeuibold"
        android:textColor="#ffff"/>

    <TextView
        android:id="@+id/email"
        android:text="Email:"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/segoeuibold"
        android:layout_marginStart="35dp"
        android:textColor="#C9C7C6"
        android:layout_marginTop="131dp"
        android:textSize="20dp"/>

    <TextView
        android:layout_centerHorizontal="true"
        android:id="@+id/emailUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:textColor="#fff"
        android:layout_marginTop="136dp"
        android:layout_marginEnd="15dp"
        android:textSize="15dp"
        android:layout_toEndOf="@+id/email"
        android:fontFamily="@font/semiboldsegoeui"/>

    <Button
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bvoltar"
        android:id="@+id/bVoltar"
        android:onClick="voltar"/>

    <TextView
        android:id="@+id/desconectar"
        android:text="Sair da conta?"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/segoeuibold"
        android:layout_marginStart="35dp"
        android:textColor="#C9C7C6"
        android:layout_marginTop="170dp"
        android:textSize="20dp"/>

    <Button
        android:layout_toEndOf="@id/desconectar"
        android:layout_marginStart="30dp"
        android:layout_marginTop="7dp"
        android:layout_below="@+id/emailUser"
        android:backgroundTint="#fff"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:background="@drawable/botao"
        android:text="Desconectar"
        android:textAllCaps="false"
        android:id="@+id/desconectarB"
        />

</RelativeLayout>